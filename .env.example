# ────────────────────────────────────────────────────────────
# Versa CPE Credential Manager — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ────────────────────────────────────────────────────────────

# ─── PostgreSQL ─────────────────────────────────────────────
DB_USER=versa_app
DB_PASSWORD=change-me-db-password
DB_NAME=versa_cpe
KC_DB_USER=keycloak
KC_DB_PASSWORD=change-me-kc-db-password

# ─── Keycloak (Consoles + bootstrap) ────────────────────────
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=change-me-kc-admin
KEYCLOAK_CLIENT_ID=versa-cpe-manager
KEYCLOAK_CLIENT_SECRET=change-me-kc-client-secret
# Service account the backend uses to call Keycloak's Admin REST API
# (user listing / identity sync / user-federation status). The client
# `versa-cpe-admin` and its realm-management role grants are declared in
# keycloak/realm-config/versa-telecom-realm.json; only the secret is injected
# here and resolved at realm-import time via ${env.KC_ADMIN_CLIENT_SECRET}.
KEYCLOAK_ADMIN_CLIENT_ID=versa-cpe-admin
KC_ADMIN_CLIENT_SECRET=change-me-kc-admin-client-secret
# Demo realm users injected at realm import. Override per environment; in
# production replace these with real user provisioning (see README).
KC_DEMO_ADMIN_PASSWORD=change-me-demo-admin
KC_DEMO_OPS_PASSWORD=change-me-demo-ops
KC_DEMO_FIELD_PASSWORD=change-me-demo-field

# ─── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ─── Backend ────────────────────────────────────────────────
# mock_vault is the DEV-ONLY secret store implementation
SECRET_STORE_TYPE=mock_vault

# ─── Active Directory (filled during LDAP integration) ──────
# LDAPS URL to your AD/LDAP server. Multiple URLs space-separated.
AD_CONNECTION_URL=ldaps://ad.example.com:636
# Service account used by Keycloak to bind & query the directory
AD_SERVICE_ACCOUNT_DN=cn=keycloak-service,ou=Service Accounts,dc=corp,dc=example,dc=com
AD_SERVICE_ACCOUNT_PASSWORD=change-me-ad-service-account
# Base DN where application users live (VERSIONS: confirm with AD team)
AD_USERS_DN=OU=Versa Users,DC=corp,DC=example,DC=com

# ─── Versa Director (Phase 4 lab values) ────────────────────
# Per-Director credentials are stored in the SecretStore at runtime;
# these placeholders document the shape only.
VERSA_OAUTH_CLIENT_ID=versa-cpe-manager
VERSA_API_BASE=https://director.example.com:9183