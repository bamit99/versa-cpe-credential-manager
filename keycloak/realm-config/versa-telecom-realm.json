{
  "realm": "versa-telecom",
  "enabled": true,
  "displayName": "Versa Telecom CPE Manager",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "sslRequired": "external",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full system access - manages CPE inventory, rotations, audit and application configuration"
      },
      {
        "name": "security_operator",
        "description": "Can view CPEs, initiate credential rotations and view audit events"
      },
      {
        "name": "field_engineer",
        "description": "Can view authorised CPEs and request credential access"
      }
    ]
  },
  "groups": [
    {
      "name": "versa-admins",
      "path": "/versa-admins"
    },
    {
      "name": "security-operators",
      "path": "/security-operators"
    },
    {
      "name": "field-engineers",
      "path": "/field-engineers"
    }
  ],
  "clients": [
    {
      "clientId": "versa-cpe-manager",
      "name": "Versa CPE Manager SPA",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://localhost/*",
        "https://localhost:8443/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "https://localhost",
        "https://localhost:8443",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-versa-cpe-manager",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "versa-cpe-manager",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "audience-account",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "account",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "versa-cpe-admin",
      "name": "Versa CPE Manager Admin API (service account)",
      "description": "Service account used by the backend to read Keycloak users, roles and user-federation status. Secret is injected during the import step (kc.sh import replaces ${...} from the environment; define it as KC_ADMIN_CLIENT_SECRET).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${KC_ADMIN_CLIENT_SECRET}"
    }
  ],
  "users": [
    {
      "id": "a1111111-1111-1111-1111-111111111111",
      "username": "admin",
      "enabled": true,
      "email": "admin@versa-dev.local",
      "firstName": "Versa",
      "lastName": "Administrator",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KC_DEMO_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "id": "a2222222-2222-2222-2222-222222222222",
      "username": "ops",
      "enabled": true,
      "email": "ops@versa-dev.local",
      "firstName": "Security",
      "lastName": "Operator",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KC_DEMO_OPS_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["security_operator"]
    },
    {
      "id": "a3333333-3333-3333-3333-333333333333",
      "username": "field",
      "enabled": true,
      "email": "field@versa-dev.local",
      "firstName": "Field",
      "lastName": "Engineer",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KC_DEMO_FIELD_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["field_engineer"]
    },
    {
      "username": "service-account-versa-cpe-admin",
      "enabled": true,
      "serviceAccountClientId": "versa-cpe-admin",
      "clientRoles": {
        "realm-management": [
          "view-realm",
          "view-users",
          "query-users",
          "query-groups"
        ]
      }
    }
  ],
  "userFederationProviders": []
}